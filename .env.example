# =============================================================================
# OpenAlpha_Evolve Triple-Provider Model Configuration
# =============================================================================
# The recursive learning loop now supports three model roles out of the box:
#   - CLAUDE_MODEL   : anthropic/claude-sonnet-5  (deep reasoning / refinement)
#   - KIMI_MODEL     : moonshot/kimi-k3           (broad exploration)
#   - GEMINI_MODEL   : gemini/gemini-3.1-pro-preview (alternate refinement / exploration)
#
# You can override any model string, base URL, or API key below. If an API key
# is left empty, LiteLLM falls back to the provider's standard env var
# (ANTHROPIC_API_KEY, MOONSHOT_API_KEY, GOOGLE_API_KEY / GEMINI_API_KEY).
# =============================================================================

CLAUDE_MODEL=anthropic/claude-sonnet-5
# CLAUDE_BASE_URL=
# CLAUDE_API_KEY=your_anthropic_api_key   # falls back to ANTHROPIC_API_KEY

KIMI_MODEL=moonshot/kimi-k3
# KIMI_BASE_URL=
# KIMI_API_KEY=your_moonshot_api_key      # falls back to MOONSHOT_API_KEY

GEMINI_MODEL=gemini/gemini-3.1-pro-preview
# GEMINI_BASE_URL=
# GEMINI_API_KEY=your_gemini_api_key      # falls back to GOOGLE_API_KEY or GEMINI_API_KEY

# --- Role mapping for the evolutionary loop ---
# LLM_PRIMARY_MODEL is used for bug-fixing and high-fitness refinement.
# Defaults to GEMINI_MODEL if unset.
LLM_PRIMARY_MODEL=gemini/gemini-3.1-pro-preview
# LLM_SECONDARY_MODEL is used for initial population generation and low-fitness
# mutations. Defaults to KIMI_MODEL if unset.
LLM_SECONDARY_MODEL=moonshot/kimi-k3
# Correctness score (0.0-1.0) a parent program must reach before its
# mutations switch from LLM_SECONDARY_MODEL to LLM_PRIMARY_MODEL. Defaults to
# 0.8 in config/settings.py if unset.
# HIGH_FITNESS_THRESHOLD_FOR_PRIMARY_LLM=0.8

# Enable automatic model cycling across Claude / Kimi / Gemini each generation.
# This increases diversity and makes the recursive learning loop more robust.
ENABLE_MODEL_CYCLING=True

EVALUATION_MODEL=gpt-4o
# EVALUATION_BASE_URL=
# EVALUATION_API_KEY=your_openai_api_key  # falls back to OPENAI_API_KEY

# --- LiteLLM Configuration ---
# Fallback default model string for litellm.
# See litellm documentation for more model strings: https://docs.litellm.ai/docs/providers
LITELLM_DEFAULT_MODEL="gemini/gemini-2.0-flash-lite"

# Provider-standard API keys LiteLLM will pick up automatically.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# MOONSHOT_API_KEY=your_moonshot_api_key
# GOOGLE_API_KEY=your_google_api_key
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# For Google Cloud services (Vertex AI, AI Studio) using Application Default Credentials (ADC)
# with a service account key, set the path to your JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# For Google Cloud services (Vertex AI, AI Studio) using Application Default Credentials (ADC)
# with a service account key, set the path to your JSON key file.
# This is often used in conjunction with models like "vertex_ai/gemini-1.5-pro-preview-0409".
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# API keys for models accessed via litellm should generally be set as environment variables
# that litellm recognizes (e.g., OPENAI_API_KEY, COHERE_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY).
# litellm will automatically pick these up. Refer to litellm documentation for specific provider needs.
# Example:
# OPENAI_API_KEY=your_openai_api_key
# AZURE_API_KEY=your_azure_api_key # (for Azure OpenAI, also need other AZURE_* vars)

# LITELLM_MAX_TOKENS=4096
# LITELLM_TEMPERATURE=1.0
# LITELLM_TOP_P=0.9
# LITELLM_TOP_K=40
